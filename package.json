{
  "name": "@loommii/dsh-input-history",
  "version": "0.1.1",
  "description": "Arrow-key input history for the DeepSeek Harness Web GUI: press Up/Down at the composer boundary to recall previously sent messages, with a floating history dropdown and a /history command that opens the same panel from the slash menu. Built for the Lexical contenteditable composer (dsh >= 0.1.2-rc.1).",
  "author": "loommii",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "web",
    "client",
    "input",
    "history",
    "composer",
    "contenteditable",
    "lexical",
    "keyboard"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
